{
  "review": {
    "object": {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "before-policy",
        "namespace": "opa-demo",
        "labels": {
          "run": "before-policy"
        }
      },
      "spec": {
        "restartPolicy": "Never",
        "containers": [
          {
            "name": "before-policy",
            "image": "nginxinc/nginx-unprivileged:stable",
            "ports": [
              {
                "containerPort": 8080
              }
            ]
          }
        ],
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 101,
          "runAsGroup": 101
        }
      }
    }
  },
  "parameters": {
    "labels": [
      "owner"
    ]
  }
}
